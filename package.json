{
	"name": "obsidian-nested-markdown-renderer",
	"version": "0.2.1",
	"description": "Render nested GFM tables and repair indented callouts in Obsidian Live Preview.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "tsx --test tests/table-parser.test.ts",
		"check": "npm run lint && npm run test && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoeChen2me/obsidian-nested-markdown-renderer.git"
	},
	"bugs": {
		"url": "https://github.com/JoeChen2me/obsidian-nested-markdown-renderer/issues"
	},
	"homepage": "https://github.com/JoeChen2me/obsidian-nested-markdown-renderer#readme",
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"live-preview",
		"markdown-table",
		"callout"
	],
	"author": "JoeChen2me",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.13.1",
		"tsx": "4.23.12",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
